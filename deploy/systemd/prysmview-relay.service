[Unit]
Description=PrysmView iroh Relay Server
After=network.target

[Service]
Type=simple
User=prysmview
Group=prysmview
ExecStart=/usr/local/bin/prysmview-relay --addr 0.0.0.0:3340
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prysmview-relay

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
