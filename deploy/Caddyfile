# PrysmView Signaling API - Caddy reverse proxy com TLS automático (Let's Encrypt)
# Redireciona HTTP (80) para HTTPS (443) e encerra TLS no Caddy.

# --- HTTP para HTTPS redirect ---
:80 {
    redir https://{host}{uri} permanent
}

# --- HTTPS: terminação TLS e proxy para a API Go ---
prysmview.duckdns.org {
    # HSTS: navegadores só usam HTTPS por 1 ano, inclui subdomínios, permite pré-carregamento
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Não exibe informações do servidor em cabeçalhos
    header / Server ""

    # Reverse proxy para a API Go em localhost:8080 (HTTP puro internamente)
    reverse_proxy 127.0.0.1:8080 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Port {server_port}
    }

    # TLS: certificado automático via Let's Encrypt
    # Caddy escolhe automaticamente suítes fortes modernas (TLS 1.2/1.3)
    tls {
        protocols tls1.2 tls1.3
    }
}