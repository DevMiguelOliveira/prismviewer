// Resource Script para o PrysmView
// Contem Icone oficial, Manifest do Windows 10/11 e Metadados de Autenticidade (VERSIONINFO)

1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "PrysmView Security Solutions\0"
            VALUE "FileDescription", "PrysmView - Solucao de Acesso Remoto Corporativo\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "PrysmView\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 PrysmView Team. Todos os direitos reservados.\0"
            VALUE "OriginalFilename", "PrysmView.exe\0"
            VALUE "ProductName", "PrysmView Remote Support\0"
            VALUE "ProductVersion", "0.1.0.0\0"
            VALUE "Comments", "Software seguro de assistencia remota auditada ponta a ponta.\0"
        END
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PrysmView Security Solutions\0"
            VALUE "FileDescription", "PrysmView - Enterprise Remote Support Solution\0"
            VALUE "FileVersion", "0.1.0.0\0"
            VALUE "InternalName", "PrysmView\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 PrysmView Team. All rights reserved.\0"
            VALUE "OriginalFilename", "PrysmView.exe\0"
            VALUE "ProductName", "PrysmView Remote Support\0"
            VALUE "ProductVersion", "0.1.0.0\0"
            VALUE "Comments", "Secure end-to-end audited remote support software.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200, 0x0409, 1200
    END
END
